/* COMPLEMENT_BIND(name, action) -- wrap a full binding as a parameterless
 * behavior, for use where only a bare behavior is accepted.
 *
 * The wrapper must take no parameters, hold a full binding, and pass on the
 * triggering event unchanged, so that the binding sees the original timestamp.
 * Macros fail the last: they run their bindings from the behavior queue, which
 * gives each one a new timestamp. Mod-morph meets all three. With `mods = <0>`
 * it never morphs, so the required second binding is `&none`.
 */
#define COMPLEMENT_BIND(name, action)                                          \
    name: name {                                                               \
        compatible = "zmk,behavior-mod-morph";                                 \
        #binding-cells = <0>;                                                  \
        mods = <0>;                                                            \
        bindings = <action>, <&none>;                                          \
    };


/* COMPLEMENT_HOLD(name, on_tap, on_hold, dwell) -- define a complement key: a
 * tap of `on_tap`, a deliberate hold of `on_hold`. Both are full bindings
 * (&kp C_NEXT, &soft_off, ...); `dwell` is the hold time in ms, one of the named
 * dwell durations below (FUNCTION_HOLD_MS, DESTRUCTIVE_HOLD_MS) -- pick the most
 * specific that fits.
 *
 * The hold never fires by accident: it commits only past `dwell`, never on an
 * adjacent key. Each branch behaves exactly as its raw binding: a hold starts
 * at `dwell` and stays down until release. Pressing the same key again within
 * COMPLEMENT_REPRESS_MS of its last press forces the tap, so tap-then-hold
 * stays down like a plain &kp.
 *
 * The keymap invokes a complement bare, as `&name`.
 */
#define COMPLEMENT_HOLD(name, on_tap, on_hold, dwell)                          \
    / {                                                                        \
        behaviors {                                                            \
            COMPLEMENT_BIND(name, &name##_ht 0 0)                              \
            name##_ht: name##_ht {                                             \
                compatible = "zmk,behavior-hold-tap";                          \
                /* ZMK mandates two cells here; unused, fed by the wrapper  */ \
                /* above so the keymap can invoke the complement bare.      */ \
                #binding-cells = <2>;                                          \
                flavor = "tap-preferred";                                      \
                tapping-term-ms = <dwell>;                                     \
                quick-tap-ms = <COMPLEMENT_REPRESS_MS>;                        \
                bindings = <&name##_h>, <&name##_t>;                           \
            };                                                                 \
            /* Bake each branch into a parameterless behavior the hold-tap  */ \
            /* can name: the action is fixed here, never supplied at        */ \
            /* invocation.                                                  */ \
            COMPLEMENT_BIND(name##_t, on_tap)                                  \
            COMPLEMENT_BIND(name##_h, on_hold)                                 \
        };                                                                     \
    };


/* FUNCTION_HOLD_MS: dwell for everyday keyboard functions (media, brightness,
 * volume). More consequential complements take a longer term of their own
 * (e.g. DELIBERATE_HOLD_MS). */
#ifndef FUNCTION_HOLD_MS
#define FUNCTION_HOLD_MS    600
#endif

/* COMPLEMENT_REPRESS_MS: window after a complement's press in which pressing it
 * again forces the tap, whatever the dwell. Taken from the first press, not its
 * release.
 */
#ifndef COMPLEMENT_REPRESS_MS
#define COMPLEMENT_REPRESS_MS    300
#endif

/* play/pause; hold skips forward */
COMPLEMENT_HOLD(play_next, &kp C_PP,   &kp C_NEXT, FUNCTION_HOLD_MS)

/* mute; hold skips back */
COMPLEMENT_HOLD(mute_prev, &kp C_MUTE, &kp C_PREV, FUNCTION_HOLD_MS)

/* brightness up; hold sets to auto */
COMPLEMENT_HOLD(bri_up_auto, &kp C_BRI_UP, &kp C_BRI_AUTO, FUNCTION_HOLD_MS)

/* brightness down; hold sets to minimum */
COMPLEMENT_HOLD(bri_dn_min, &kp C_BRI_DN, &kp C_BRI_MIN, FUNCTION_HOLD_MS)


/* DELIBERATE_HOLD_MS: dwell for holds that must be clearly intended -- a longer
 * press guarding costly actions (power-off, studio unlock, BT clear) against an
 * accidental trigger.
 */
#ifndef DELIBERATE_HOLD_MS
#define DELIBERATE_HOLD_MS    1000
#endif

/* keyboard soft-off; hold unlocks keymap for ZMK studio */
COMPLEMENT_HOLD(power_studio, &soft_off, &studio_unlock, DELIBERATE_HOLD_MS)
