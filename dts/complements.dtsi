/* COMPLEMENT_HOLD(name, tap, hold, dwell) -- define a complement key: a tap of
 * `tap`, a deliberate hold of `hold`. Both are full bindings (&kp C_NEXT,
 * &soft_off, ...); `dwell` is the hold time in ms, one of the named dwell
 * durations below (FUNCTION_HOLD_MS, DESTRUCTIVE_HOLD_MS) -- pick the most
 * specific that fits.
 *
 * The hold never fires by accident: it commits only past `dwell`, never on an
 * adjacent key. Each branch behaves exactly as its raw binding -- momentary
 * when tapped, sustained when held -- so auto-repeating keys (volume,
 * brightness) still ramp.
 *
 * Write each complement as an adjacent pair: the factory, then a one-line
 * shadow `#define name name 0 0`. That macro lives in the preprocessor's
 * namespace, distinct from the devicetree node the factory defines, so it only
 * supplies the two cells ZMK requires -- completing the sugar that lets the
 * keymap invoke bare `&name`.
 */
#define COMPLEMENT_HOLD(name, tap, hold, dwell)                                \
    / {                                                                        \
        behaviors {                                                            \
            name: name {                                                       \
                compatible = "zmk,behavior-hold-tap";                          \
                /* ZMK mandates two cells here; unused, fed by the per-key  */ \
                /* shadow so the keymap can invoke the complement bare.     */ \
                #binding-cells = <2>;                                          \
                flavor = "tap-preferred";                                      \
                tapping-term-ms = <dwell>;                                     \
                bindings = <&name##_h>, <&name##_t>;                           \
            };                                                                 \
        };                                                                     \
        /* Bake each branch into a parameterless behavior the hold-tap can  */ \
        /* name -- a macro with 0 binding cells: the action is fixed here,  */ \
        /* never supplied at invocation.                                    */ \
        macros {                                                               \
            name##_t: name##_t {                                               \
                compatible = "zmk,behavior-macro";                             \
                #binding-cells = <0>;                                          \
                /* No inter-step delay: fire as promptly as a raw binding.  */ \
                wait-ms = <0>;                                                 \
                /* Hold the binding for the hold-tap's whole press, so the  */ \
                /* branch acts exactly as the binding driven directly and   */ \
                /* sustains while held (a held volume/brightness key        */ \
                /* repeats): press, pause for release, release.             */ \
                bindings = <&macro_press tap>,                                 \
                           <&macro_pause_for_release>,                         \
                           <&macro_release tap>;                               \
            };                                                                 \
            name##_h: name##_h {                                               \
                compatible = "zmk,behavior-macro";                             \
                #binding-cells = <0>;                                          \
                wait-ms = <0>;                                                 \
                bindings = <&macro_press hold>,                                \
                           <&macro_pause_for_release>,                         \
                           <&macro_release hold>;                              \
            };                                                                 \
        };                                                                     \
    };


/* FUNCTION_HOLD_MS: dwell for everyday keyboard functions (media, brightness,
 * volume). More consequential complements take a longer term of their own
 * (e.g. DESTRUCTIVE_HOLD_MS). */
#ifndef FUNCTION_HOLD_MS
#define FUNCTION_HOLD_MS    600
#endif

/* play/pause; hold skips forward */
COMPLEMENT_HOLD(play_next, &kp C_PP,   &kp C_NEXT, FUNCTION_HOLD_MS)
#define play_next    play_next 0 0

/* mute; hold skips back */
COMPLEMENT_HOLD(mute_prev, &kp C_MUTE, &kp C_PREV, FUNCTION_HOLD_MS)
#define mute_prev    mute_prev 0 0

/* brightness up; hold sets to auto */
COMPLEMENT_HOLD(bri_up_auto, &kp C_BRI_UP, &kp C_BRI_AUTO, FUNCTION_HOLD_MS)
#define bri_up_auto    bri_up_auto 0 0

/* brightness down; hold sets to minimum */
COMPLEMENT_HOLD(bri_dn_min, &kp C_BRI_DN, &kp C_BRI_MIN, FUNCTION_HOLD_MS)
#define bri_dn_min    bri_dn_min 0 0
