/* Maximum milliseconds between releasing one key and pressing the next, at your natural
 * typing cadence. Keystrokes arriving within this interval perpetuate a typing streak that
 * suppresses hold behaviors; a key arriving after it becomes eligible to trigger one.
 */
#ifndef TYPING_CADENCE
#define TYPING_CADENCE    150
#endif

/* How long a typing streak persists after the last key — home-row presses within this
 * interval are considered taps. Equal to TYPING_CADENCE: one keystroke's worth of idle
 * time is enough to clear it.
 */
#ifndef TYPING_STREAK_GRACE
#define TYPING_STREAK_GRACE    TYPING_CADENCE
#endif

/* Extra hold duration beyond TYPING_CADENCE before each finger's modifier fires.
 * Outer fingers use higher values to reduce accidental holds from imprecise presses.
 */
#ifndef HOME_PINKY_HOLD_LAG
#define HOME_PINKY_HOLD_LAG    120
#endif
#ifndef HOME_RINGY_HOLD_LAG
#define HOME_RINGY_HOLD_LAG     90
#endif
#ifndef HOME_MIDDY_HOLD_LAG
#define HOME_MIDDY_HOLD_LAG     60
#endif
#ifndef HOME_INDEX_HOLD_LAG
#define HOME_INDEX_HOLD_LAG     30
#endif

/* By how many milliseconds per-finger to shorten TYPING_STREAK_GRACE, causing
 * its hold action to become eligible before the typing streak has timed out.
 */
#ifndef HOME_PINKY_HOLD_LEAD
#define HOME_PINKY_HOLD_LEAD     0
#endif
#ifndef HOME_RINGY_HOLD_LEAD
#define HOME_RINGY_HOLD_LEAD     0
#endif
#ifndef HOME_MIDDY_HOLD_LEAD
#define HOME_MIDDY_HOLD_LEAD     0
#endif
#ifndef HOME_INDEX_HOLD_LEAD
#define HOME_INDEX_HOLD_LEAD    80
#endif

/* How readily each finger commits to its modifier when held. "tap-preferred" requires
 * holding that long regardless; "balanced" also fires the moment another key is pressed
 * and released while held, without needing to reach that duration.
 */
#ifndef HOME_PINKY_HOLD_KIND
#define HOME_PINKY_HOLD_KIND    "tap-preferred"
#endif
#ifndef HOME_RINGY_HOLD_KIND
#define HOME_RINGY_HOLD_KIND    "tap-preferred"
#endif
#ifndef HOME_MIDDY_HOLD_KIND
#define HOME_MIDDY_HOLD_KIND    "tap-preferred"
#endif
#ifndef HOME_INDEX_HOLD_KIND
#define HOME_INDEX_HOLD_KIND    "tap-preferred"
#endif

/* Extend the grace period beyond TYPING_CADENCE after a tap, during which releasing
 * and then holding the same key again produces repeat events rather than the modifier.
 */
#ifndef HOME_KEY_REPEAT_GRACE
#define HOME_KEY_REPEAT_GRACE    150
#endif

/* Activate the SHIFT modifier the moment its key is pressed down, without waiting
 * for its release within the tapping term. If released in time to be considered a tap,
 * the modifier key is released and tap behavior triggers.
 */
#ifndef HOME_INSTANT_SHIFT
#define HOME_INSTANT_SHIFT    0
#endif


#define ZMK_HRM(name, triggers, kind, lag, lead, ...) \
    / { behaviors { name: name { \
        compatible = "zmk,behavior-hold-tap"; \
        #binding-cells = <2>; \
        bindings = <&kp>, <&kp>; \
        flavor = kind; \
        quick-tap-ms = <(TYPING_CADENCE + HOME_KEY_REPEAT_GRACE)>; \
        tapping-term-ms = <(TYPING_CADENCE + lag)>; \
        require-prior-idle-ms = <(TYPING_STREAK_GRACE - lead)>; \
        hold-trigger-key-positions = <triggers>; \
        hold-trigger-on-release; \
        __VA_ARGS__ }; }; };

ZMK_HRM(lhp, KEYS_R, HOME_PINKY_HOLD_KIND, HOME_PINKY_HOLD_LAG, HOME_PINKY_HOLD_LEAD)
ZMK_HRM(lhr, KEYS_R, HOME_RINGY_HOLD_KIND, HOME_RINGY_HOLD_LAG, HOME_RINGY_HOLD_LEAD)
ZMK_HRM(lhm, KEYS_R, HOME_MIDDY_HOLD_KIND, HOME_MIDDY_HOLD_LAG, HOME_MIDDY_HOLD_LEAD)
ZMK_HRM(lhi, KEYS_R, HOME_INDEX_HOLD_KIND, HOME_INDEX_HOLD_LAG, HOME_INDEX_HOLD_LEAD)
ZMK_HRM(rhi, KEYS_L, HOME_INDEX_HOLD_KIND, HOME_INDEX_HOLD_LAG, HOME_INDEX_HOLD_LEAD)
ZMK_HRM(rhm, KEYS_L, HOME_MIDDY_HOLD_KIND, HOME_MIDDY_HOLD_LAG, HOME_MIDDY_HOLD_LEAD)
ZMK_HRM(rhr, KEYS_L, HOME_RINGY_HOLD_KIND, HOME_RINGY_HOLD_LAG, HOME_RINGY_HOLD_LEAD)
ZMK_HRM(rhp, KEYS_L, HOME_PINKY_HOLD_KIND, HOME_PINKY_HOLD_LAG, HOME_PINKY_HOLD_LEAD)

#if HOME_INSTANT_SHIFT
&lhi { hold-while-undecided; };
&rhi { hold-while-undecided; };
#endif
