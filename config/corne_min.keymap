#define ENABLED 1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* standard 42-key Corne positions (index = order in keymap bindings) */
#define KEYS_L  0  1  2  3  4  5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define KEYS_R  6  7  8  9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41


#define FUNCTION_HOLD_MS 400

#include "complements.dtsi"

/* hold duration before BT profile clear fires (long to prevent accidental re-pair) */
#define BT_CLEAR_HOLD_MS 1000

#include "bt_profile.dtsi"

/* activate shift the moment the home key is depressed, emit a character if not held */
#define HOME_INSTANT_SHIFT ENABLED

#include "hrm.dtsi"


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
/*
    Colemak Mod-DH customized by spikespaz
    |  TAB |  Q  |  W  |  F  |  P  |  B  |      |  J  |  L  |  U  |  Y  |  ;  |  -  |
    | CAPSW|  A  |  R  |  S  |  T  |  G  |      |  M  |  N  |  E  |  I  |  O  |  '  |
    |   `  |  Z  |  X  |  C  |  D  |  V  |      |  K  |  H  |  ,  |  .  |  /  |  \  |
                       | SYS | ESC | SPC |      | BSPC| RET | RSE |
*/
            bindings = <
    &kp TAB     &kp Q      &kp W      &kp F      &kp P      &kp B           &kp J     &kp L      &kp U      &kp Y      &kp SEMI   &kp MINUS
    &caps_word  &lhp(A)    &lhr(R)    &lhm(S)    &lhi(T)    &kp G           &kp M     &rhi(N)    &rhm(E)    &rhr(I)    &rhp(O)    &kp SQT
    &kp GRAVE   &kp Z      &kp X      &kp C      &kp D      &kp V           &kp K     &kp H      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
    /*          |          |        */&mo 1      &kp ESC    &kp SPACE       &kp BSPC  &kp RET    &mo 2
            >;
        };

        system_layer {
            display-name = "System";
/*
    |  F1    |  F2 |  F3 |  F4 |  F5 |  F6 |      |  F7 |  F8 |  F9 | F10 | F11 |  F12 |
    | OUT_USB| BT1 | BT2 | BT3 | BT4 | BT5 |      |     | VO+ | BR+ |     |     |      |
    | SHFT   |     | PREV| PP  |     |     |      |     | VO- | BR- |     |     |      |
                         |     |     | SPC |      | ENT |     |     |
*/
            bindings = <
    &kp F1        &kp F2       &kp F3       &kp F4       &kp F5       &kp F6            &kp F7   &kp F8        &kp F9        &kp F10  &kp F11    &kp F12
    &out OUT_USB  &bt_p(0)     &bt_p(1)     &bt_p(2)     &bt_p(3)     &bt_p(4)          &trans   &kp C_VOL_UP  &kp C_BRI_UP  &trans   &trans     &trans
    &kp LSHFT     &trans       &mute_prev   &play_next   &trans       &trans            &trans   &kp C_VOL_DN  &kp C_BRI_DN  &trans   &trans     &trans
    /*            |            |          */&trans       &trans       &kp SPACE         &kp RET  &trans        &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
/*
    |  TAB |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  (  |  )  | BSPC |
    | CTRL |     |     |     |     |     |      |  -  |  =  |  [  |  ]  |  \  |  `   |
    | SHFT |     |     |     |     |     |      |  _  |  +  |  {  |  }  | "|" |  ~   |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp  TAB       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
    &studio_unlock &trans   &trans    &trans    &trans    &trans          &kp MINUS   &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
    &kp LSHFT      &trans   &trans    &trans    &trans    &trans          &kp UNDER   &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
    /*             |        |       */&kp LGUI  &trans    &kp SPACE       &kp RET     &trans     &kp RALT
            >;
        };

        extra1 {
            display-name = "Extra-1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra-2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra-3";
            status = "reserved";
        };
    };
};
