#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Sunaku level-0 timings: TAPPING_RESOLUTION=150ms, offsets per finger:
 *   index +30=180ms, middle +60=210ms, ring +90=240ms, pinky +120=270ms
 * STREAK_DECAY (require-prior-idle-ms) = 150ms
 * REPEAT_DECAY (quick-tap-ms)          = 300ms
 */
#define HRM_BASE \
    compatible = "zmk,behavior-hold-tap"; \
    flavor = "balanced"; \
    quick-tap-ms = <300>; \
    require-prior-idle-ms = <150>;

/ {
    behaviors {
        /* GACS outer→inner: pinky=GUI, ring=ALT, middle=CTL, index=SFT */
        lhp: homerow_left_pinky  { HRM_BASE #binding-cells = <1>; tapping-term-ms = <270>; bindings = <&kp LGUI>, <&kp>; };
        lhr: homerow_left_ring   { HRM_BASE #binding-cells = <1>; tapping-term-ms = <240>; bindings = <&kp LALT>, <&kp>; };
        lhm: homerow_left_middle { HRM_BASE #binding-cells = <1>; tapping-term-ms = <210>; bindings = <&kp LCTL>, <&kp>; };
        lhi: homerow_left_index  { HRM_BASE #binding-cells = <1>; tapping-term-ms = <180>; bindings = <&kp LSFT>, <&kp>; };
        rhi: homerow_right_index { HRM_BASE #binding-cells = <1>; tapping-term-ms = <180>; bindings = <&kp RSFT>, <&kp>; };
        rhm: homerow_right_middle{ HRM_BASE #binding-cells = <1>; tapping-term-ms = <210>; bindings = <&kp RCTL>, <&kp>; };
        rhr: homerow_right_ring  { HRM_BASE #binding-cells = <1>; tapping-term-ms = <240>; bindings = <&kp RALT>, <&kp>; };
        rhp: homerow_right_pinky { HRM_BASE #binding-cells = <1>; tapping-term-ms = <270>; bindings = <&kp RGUI>, <&kp>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
/*
    Colemak Mod-DH customized by spikespaz
    |  TAB |  Q  |  W  |  F  |  P  |  B  |      |  J  |  L   |  U  |  Y  |  ;  | BSPC |
    | CTRL |  A  |  R  |  S  |  T  |  G  |      |  M  |  N   |  E  |  I  |  O  |  '   |
    | SHFT |  Z  |  X  |  C  |  D  |  V  |      |  K  |  H   |  ,  |  .  |  /  | ESC  |
                       | GUI | LWR | SPC |      | ENT | RSE  | ALT |
*/
            bindings = <
    &kp TAB    &kp Q   &kp W   &kp F    &kp P   &kp B         &kp J   &kp L   &kp U     &kp Y   &kp SEMI  &kp BSPC
    &kp LCTRL  &lhp A  &lhr R  &lhm S   &lhi T  &kp G         &kp M   &rhi N  &rhm E    &rhr I  &rhp O    &kp SQT
    &kp LSHFT  &kp Z   &kp X   &kp C    &kp D   &kp V         &kp K   &kp H   &kp COMMA &kp DOT &kp FSLH  &kp ESC
    /*         |      |    */&kp LGUI   &mo 1   &kp SPACE     &kp RET &mo 2   &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
/*
    |  TAB |  1  |  2  |  3  |  4  |  5  |      |  6  |  7  |  8  |  9  |  0  | BSPC |
    | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |      | LFT | DWN |  UP | RGT |     |      |
    | SHFT |     |     |     |     |     |      |     |     |     |     |     |      |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp TAB     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6      &kp N7      &kp N8    &kp N9       &kp N0    &kp BSPC
    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &trans    &trans
    &kp LSHFT   &trans       &trans       &trans       &trans       &trans            &trans      &trans      &trans    &trans       &trans    &trans
    /*          |            |          */&kp LGUI     &trans       &kp SPACE         &kp RET     &trans      &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
/*
    |  TAB |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  (  |  )  | BSPC |
    | CTRL |     |     |     |     |     |      |  -  |  =  |  [  |  ]  |  \  |  `   |
    | SHFT |     |     |     |     |     |      |  _  |  +  |  {  |  }  | "|" |  ~   |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp  TAB       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
    &studio_unlock &trans   &trans    &trans    &trans    &trans          &kp MINUS   &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
    &kp LSHFT      &trans   &trans    &trans    &trans    &trans          &kp UNDER   &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
    /*             |        |       */&kp LGUI  &trans    &kp SPACE       &kp RET     &trans     &kp RALT
            >;
        };

        extra1 {
            display-name = "Extra-1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra-2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra-3";
            status = "reserved";
        };
    };
};
