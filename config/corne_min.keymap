#define ENABLED 1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* standard 42-key Corne positions (index = order in keymap bindings) */
#define KEYS_L  0  1  2  3  4  5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define KEYS_R  6  7  8  9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41


#define FUNCTION_HOLD_MS       400
#define DELIBERATE_HOLD_MS    1000

#include "complements.dtsi"

/* hold duration before BT profile clear fires (long to prevent accidental re-pair) */
#define BT_CLEAR_HOLD_MS    DELIBERATE_HOLD_MS

#include "bt_profile.dtsi"

/* activate shift the moment the home key is depressed, emit a character if not held */
#define HOME_INSTANT_SHIFT    ENABLED

#include "hrm.dtsi"


/* For left-half system layer: tap sets output to USB, or long-hold to enter bootloader */
COMPLEMENT_HOLD(usb_boot, &out OUT_USB, &bootloader, DELIBERATE_HOLD_MS)
#define usb_boot    usb_boot 0 0

/* For right-half system layer: long-hold to enter bootloader */
COMPLEMENT_HOLD(none_boot, &none, &bootloader, DELIBERATE_HOLD_MS)
#define none_boot    none_boot 0 0

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
/*
    Colemak Mod-DH customized by spikespaz
    |  TAB |  Q  |  W  |  F  |  P  |  B  |      |  J  |  L   |  U  |  Y  |  ;  |  -  |
    | CAPSW|  A  |  R  |  S  |  T  |  G  |      |  M  |  N   |  E  |  I  |  O  |  '  |
    |   `  |  Z  |  X  |  C  |  D  |  V  |      |  K  |  H   |  ,  |  .  |  /  |  \  |
                       | SYS | ESC | SPC |      | ENT | BSPC | RSE |
*/
            bindings = <
    &kp TAB     &kp Q      &kp W      &kp F      &kp P      &kp B           &kp J     &kp L      &kp U      &kp Y      &kp SEMI   &kp MINUS
    &caps_word  &lhp(A)    &lhr(R)    &lhm(S)    &lhi(T)    &kp G           &kp M     &rhi(N)    &rhm(E)    &rhr(I)    &rhp(O)    &kp SQT
    &kp GRAVE   &kp Z      &kp X      &kp C      &kp D      &kp V           &kp K     &kp H      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
    /*          |          |        */&mo 1      &kp ESC    &kp SPACE       &kp RET   &kp BSPC   &mo 2
            >;
        };

        system_layer {
            display-name = "System";
/*
    |  F1    |  F2 |  F3 |  F4 |  F5 |  F6  |      |   F7  |  F8 |  F9 | F10 | F11 |  F12 |
    | CAPS   | GUI | ALT | CTL | SFT |      |      |PLY/NXT| VO+ | BR+ |     |     | PRSC |
    | USB/BL | BT1 | BT2 | BT3 | BT4 | BT5  |      |MUT/PRV| VO- | BR- |     |     | BOOT |
                         |     |     |PWR/ST|      | DEL   |     |     |
*/
            bindings = <
    &kp F1        &kp F2       &kp F3       &kp F4       &kp F5       &kp F6            &kp F7      &kp F8        &kp F9        &kp F10    &kp F11    &kp F12
    &kp CAPS      &kp LGUI     &kp LALT     &kp LCTL     &kp LSFT     &none             &play_next  &kp C_VOL_UP  &bri_up_auto  &none      &none      &kp PRSC
    &usb_boot     &bt_p(0)     &bt_p(1)     &bt_p(2)     &bt_p(3)     &bt_p(4)          &mute_prev  &kp C_VOL_DN  &bri_dn_min   &none      &none      &none_boot
    /*            |            |          */&none        &none        &power_studio     &kp DEL     &none         &none
            >;
        };

        raise_layer {
            display-name = "Raise";
/*
    |  TAB |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  (  |  )  | BSPC |
    | CTRL |     |     |     |     |     |      |  -  |  =  |  [  |  ]  |  \  |  `   |
    | SHFT |     |     |     |     |     |      |  _  |  +  |  {  |  }  | "|" |  ~   |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp  TAB       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
    &studio_unlock &none    &none     &none     &none     &none           &kp MINUS   &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
    &kp LSHFT      &none    &none     &none     &none     &none           &kp UNDER   &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
    /*             |        |       */&kp LGUI  &none     &kp SPACE       &kp RET     &none      &kp RALT
            >;
        };

        extra1 {
            display-name = "Extra-1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra-2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra-3";
            status = "reserved";
        };
    };
};
