#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Sunaku level-0 timings: TAPPING_RESOLUTION=150ms, offsets per finger:
 *   index +30=180ms, middle +60=210ms, ring +90=240ms, pinky +120=270ms
 * STREAK_DECAY (require-prior-idle-ms) = 150ms
 * REPEAT_DECAY (quick-tap-ms)          = 300ms
 *
 * ZMK v0.3: zmk,behavior-hold-tap forces #binding-cells = <2> (const via
 * two_param.yaml) and bindings type is `phandles` — bare refs, no args.
 * The mod is therefore supplied at the keymap call site: &lhp LGUI A.
 */
#define HRM_BASE \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    flavor = "balanced"; \
    quick-tap-ms = <300>; \
    require-prior-idle-ms = <150>; \
    hold-trigger-on-release;

/* standard 42-key Corne positions (index = order in keymap bindings) */
#define KEYS_L  0  1  2  3  4  5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define KEYS_R  6  7  8  9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41

#define HRM_L(label, name, tt) label: name { HRM_BASE tapping-term-ms = <tt>; bindings = <&kp &kp>; hold-trigger-key-positions = <KEYS_R>; };
#define HRM_R(label, name, tt) label: name { HRM_BASE tapping-term-ms = <tt>; bindings = <&kp &kp>; hold-trigger-key-positions = <KEYS_L>; };

/ {
    behaviors {
        /* GACS outer→inner: pinky=GUI, ring=ALT, middle=CTL, index=SFT */
        HRM_L(lhp, homerow_left_pinky,  270)
        HRM_L(lhr, homerow_left_ring,   240)
        HRM_L(lhm, homerow_left_middle, 210)
        HRM_L(lhi, homerow_left_index,  180)
        HRM_R(rhi, homerow_right_index, 180)
        HRM_R(rhm, homerow_right_middle, 210)
        HRM_R(rhr, homerow_right_ring,  240)
        HRM_R(rhp, homerow_right_pinky, 270)
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
/*
    Colemak Mod-DH customized by spikespaz
    |  TAB |  Q  |  W  |  F  |  P  |  B  |      |  J  |  L   |  U  |  Y  |  ;  |  -  |
    | CAPSW|  A  |  R  |  S  |  T  |  G  |      |  M  |  N   |  E  |  I  |  O  |  '  |
    |   `  |  Z  |  X  |  C  |  D  |  V  |      |  K  |  H   |  ,  |  .  |  /  |  \  |
                       | GUI | LWR | SPC |      | ENT | RSE  | ALT |
*/
            bindings = <
    &kp TAB    &kp Q        &kp W        &kp F        &kp P        &kp B         &kp J    &kp L        &kp U        &kp Y        &kp SEMI     &kp MINUS
    &caps_word &lhp LGUI A  &lhr LALT R  &lhm LCTL S  &lhi LSFT T  &kp G         &kp M    &rhi RSFT N  &rhm RCTL E  &rhr RALT I  &rhp RGUI O  &kp SQT
    &kp GRAVE  &kp Z        &kp X        &kp C        &kp D        &kp V         &kp K    &kp H        &kp COMMA    &kp DOT      &kp FSLH     &kp BSLH
    /*         |            |          */&kp LGUI     &mo 1        &kp SPACE     &kp RET  &mo 2        &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
/*
    |  TAB |  1  |  2  |  3  |  4  |  5  |      |  6  |  7  |  8  |  9  |  0  | BSPC |
    | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |      | LFT | DWN |  UP | RGT |     |      |
    | SHFT |     |     |     |     |     |      |     |     |     |     |     |      |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp TAB     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6      &kp N7      &kp N8    &kp N9       &kp N0    &kp BSPC
    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &trans    &trans
    &kp LSHFT   &trans       &trans       &trans       &trans       &trans            &trans      &trans      &trans    &trans       &trans    &trans
    /*          |            |          */&kp LGUI     &trans       &kp SPACE         &kp RET     &trans      &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
/*
    |  TAB |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  (  |  )  | BSPC |
    | CTRL |     |     |     |     |     |      |  -  |  =  |  [  |  ]  |  \  |  `   |
    | SHFT |     |     |     |     |     |      |  _  |  +  |  {  |  }  | "|" |  ~   |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp  TAB       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
    &studio_unlock &trans   &trans    &trans    &trans    &trans          &kp MINUS   &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
    &kp LSHFT      &trans   &trans    &trans    &trans    &trans          &kp UNDER   &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
    /*             |        |       */&kp LGUI  &trans    &kp SPACE       &kp RET     &trans     &kp RALT
            >;
        };

        extra1 {
            display-name = "Extra-1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra-2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra-3";
            status = "reserved";
        };
    };
};
