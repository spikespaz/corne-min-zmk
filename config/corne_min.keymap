#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* hold duration before BT profile clear fires (long to prevent accidental re-pair) */
#define BT_CLEAR_HOLD_MS 1000

/* SHIFT_INSTANT_MOD: shift registers the moment the key is held, before the
 * hold-tap resolves. Reversed automatically if it turns out to be a tap. */
#define SHIFT_INSTANT_MOD

/* SHIFT_RECOVER_TAP: when a slow standalone hold expires past the tapping-term
 * with nothing else pressed, types the tap character instead of silence.
 * Independently usable; pairs naturally with SHIFT_INSTANT_MOD. */
// #define SHIFT_RECOVER_TAP

/* v0.3 hold-tap aliases: tap=param2, hold=param1 */
#define bt_p(n) ht_bt_profile n n

/*
 * Sunaku-style timing constants, derived from a single base resolution.
 * TAPPING_RESOLUTION is the global base; all other thresholds are offsets.
 *   PINKY +120, RINGY +90, MIDDY +60, INDEX +30 (faster fingers = shorter hold)
 * HOMEY_STREAK_DECAY -> require-prior-idle-ms: suppresses HRM during typing bursts
 * HOMEY_REPEAT_DECAY -> quick-tap-ms: tap-then-hold within this window = key repeat
 */
#define TAPPING_RESOLUTION    150

#define PINKY_HOLDING_TIME    (TAPPING_RESOLUTION + 120)
#define RINGY_HOLDING_TIME    (TAPPING_RESOLUTION +  90)
#define MIDDY_HOLDING_TIME    (TAPPING_RESOLUTION +  60)
#define INDEX_HOLDING_TIME    (TAPPING_RESOLUTION +  30)

#define HOMEY_STREAK_DECAY    TAPPING_RESOLUTION
#define HOMEY_REPEAT_DECAY    (TAPPING_RESOLUTION + 150)

#define THUMB_HOLDING_TYPE    "balanced"
#define THUMB_HOLDING_TIME    (TAPPING_RESOLUTION +  50)
#define THUMB_REPEAT_DECAY    (TAPPING_RESOLUTION + 150)

#define SPACE_HOLDING_TYPE    "tap-preferred"
#define SPACE_HOLDING_TIME    THUMB_HOLDING_TIME
#define SPACE_REPEAT_DECAY    TAPPING_RESOLUTION

/*
 * ZMK v0.3: zmk,behavior-hold-tap forces #binding-cells = <2> (const via
 * two_param.yaml) and bindings type is `phandles` — bare refs, no args.
 * The mod is therefore supplied at the keymap call site: &lhp LGUI A.
 */
#define HRM_BASE \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    flavor = "tap-preferred"; \
    quick-tap-ms = <HOMEY_REPEAT_DECAY>; \
    require-prior-idle-ms = <HOMEY_STREAK_DECAY>; \
    hold-trigger-on-release;

/* standard 42-key Corne positions (index = order in keymap bindings) */
#define KEYS_L  0  1  2  3  4  5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define KEYS_R  6  7  8  9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41

#define HRM_L(label, name, tt) label: name { HRM_BASE tapping-term-ms = <tt>; bindings = <&kp &kp>; hold-trigger-key-positions = <KEYS_R>; };
#define HRM_R(label, name, tt) label: name { HRM_BASE tapping-term-ms = <tt>; bindings = <&kp &kp>; hold-trigger-key-positions = <KEYS_L>; };

/ {
    macros {
        bt_sel: bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>, <&out OUT_BLE>;
        };

        bt_clr_sel: bt_clr_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt_sel MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
    };

    behaviors {
        space: thumb_spacebar {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = SPACE_HOLDING_TYPE;
            tapping-term-ms = <SPACE_HOLDING_TIME>;
            quick-tap-ms = <SPACE_REPEAT_DECAY>;
            bindings = <&mo>, <&kp>;
        };

        ht_bt_profile: ht_bt_profile {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <BT_CLEAR_HOLD_MS>;
            flavor = "tap-preferred"; /* important */
            bindings = <&bt_clr_sel>, <&bt_sel>;
        };

        /* GACS outer→inner: pinky=GUI, ring=ALT, middle=CTL, index=SFT */
        HRM_L(lhp, homerow_left_pinky,   PINKY_HOLDING_TIME)
        HRM_L(lhr, homerow_left_ring,    RINGY_HOLDING_TIME)
        HRM_L(lhm, homerow_left_middle,  MIDDY_HOLDING_TIME)

#if defined(SHIFT_INSTANT_MOD) || defined(SHIFT_RECOVER_TAP)
        lhi: homerow_left_index {
            HRM_BASE
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>;
#ifdef SHIFT_INSTANT_MOD
            hold-while-undecided;
#endif
#ifdef SHIFT_RECOVER_TAP
            retro-tap;
#endif
        };
        rhi: homerow_right_index {
            HRM_BASE
            tapping-term-ms = <INDEX_HOLDING_TIME>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>;
#ifdef SHIFT_INSTANT_MOD
            hold-while-undecided;
#endif
#ifdef SHIFT_RECOVER_TAP
            retro-tap;
#endif
        };
#else
        HRM_L(lhi, homerow_left_index,   INDEX_HOLDING_TIME)
        HRM_R(rhi, homerow_right_index,  INDEX_HOLDING_TIME)
#endif

        HRM_R(rhm, homerow_right_middle, MIDDY_HOLDING_TIME)
        HRM_R(rhr, homerow_right_ring,   RINGY_HOLDING_TIME)
        HRM_R(rhp, homerow_right_pinky,  PINKY_HOLDING_TIME)
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colemak-DH";
/*
    Colemak Mod-DH customized by spikespaz
    |  TAB |  Q  |  W  |  F  |  P  |  B  |      |  J  |  L   |  U  |  Y  |  ;  |  -  |
    | CAPSW|  A  |  R  |  S  |  T  |  G  |      |  M  |  N   |  E  |  I  |  O  |  '  |
    |   `  |  Z  |  X  |  C  |  D  |  V  |      |  K  |  H   |  ,  |  .  |  /  |  \  |
                       | GUI | LWR | SPC |      | ENT | RSE  | ALT |
*/
            bindings = <
    &kp TAB    &kp Q        &kp W        &kp F        &kp P        &kp B         &kp J    &kp L        &kp U        &kp Y        &kp SEMI     &kp MINUS
    &caps_word &lhp LGUI A  &lhr LALT R  &lhm LCTL S  &lhi LSFT T  &kp G         &kp M    &rhi RSFT N  &rhm RCTL E  &rhr RALT I  &rhp RGUI O  &kp SQT
    &kp GRAVE  &kp Z        &kp X        &kp C        &kp D        &kp V         &kp K    &kp H        &kp COMMA    &kp DOT      &kp FSLH     &kp BSLH
    /*         |            |          */&kp LGUI     &mo 1        &space 1 SPACE  &kp RET  &mo 2        &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
/*
    |  TAB   |  1  |  2  |  3  |  4  |  5  |      |  6  |  7  |  8  |  9  |  0  | BSPC |
    | OUT_USB| BT1 | BT2 | BT3 | BT4 | BT5 |      | LFT | DWN |  UP | RGT |     |      |
    | SHFT   |     |     |     |     |     |      |     |     |     |     |     |      |
                         | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp TAB       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6      &kp N7      &kp N8    &kp N9       &kp N0    &kp BSPC
    &out OUT_USB  &bt_p(0)     &bt_p(1)     &bt_p(2)     &bt_p(3)     &bt_p(4)          &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &trans    &trans
    &kp LSHFT     &trans       &trans       &trans       &trans       &trans            &trans      &trans      &trans    &trans       &trans    &trans
    /*            |            |          */&kp LGUI     &trans       &kp SPACE         &kp RET     &trans      &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
/*
    |  TAB |  !  |  @  |  #  |  $  |  %  |      |  ^  |  &  |  *  |  (  |  )  | BSPC |
    | CTRL |     |     |     |     |     |      |  -  |  =  |  [  |  ]  |  \  |  `   |
    | SHFT |     |     |     |     |     |      |  _  |  +  |  {  |  }  | "|" |  ~   |
                       | GUI |     | SPC |      | ENT |     | ALT |
*/
            bindings = <
    &kp  TAB       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
    &studio_unlock &trans   &trans    &trans    &trans    &trans          &kp MINUS   &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
    &kp LSHFT      &trans   &trans    &trans    &trans    &trans          &kp UNDER   &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
    /*             |        |       */&kp LGUI  &trans    &kp SPACE       &kp RET     &trans     &kp RALT
            >;
        };

        extra1 {
            display-name = "Extra-1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra-2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra-3";
            status = "reserved";
        };
    };
};
